{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [".kiro/steering/*.md"], 
  "permission": {
    "edit": "ask",
    "bash": {
      "*": "ask",
      "git status*": "allow",
      "git diff*": "allow",
      "python -m pytest*": "allow",
      "pytest*": "allow",
      "git commit*": "deny",
      "git push*": "deny",
      "Remove-Item*": "deny",
      "rm *": "deny"
    },
    "webfetch": "deny"
  }
}

